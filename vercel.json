{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/health/?",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/status/?",
      "dest": "/api/index.py"
    },
    {
      "src": "/?",
      "dest": "/api/index.py"
    }
  ]
}
