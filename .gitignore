data/image_generation/
data/video_editing/
*.db
*.sqlite
*.sqlite3

# Test and coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Type checker and linter caches
.mypy_cache/
.ruff_cache/
.pyre/

# Build artifacts
build/
dist/
*.egg-info/

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
